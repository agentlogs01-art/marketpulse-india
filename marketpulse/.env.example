# .env.example
#
# Copy to .env for local development (never commit the real .env).
# In production, set these as GitHub Actions repo secrets AND as Railway
# variables — the two platforms do not share env automatically.

# --- Supabase (persistence layer) -------------------------------------
# Project Settings -> API in the Supabase dashboard.
# Use the SERVICE ROLE key here, never the anon/public key -- this code
# runs server-side only and relies on bypassing RLS (see persistence/schema.sql).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini (AI sentiment/sector analysis, FR-02.2) --------------------
GEMINI_API_KEY=your-gemini-api-key

# --- Email (Brevo HTTP API — this is what the sender actually uses) ----
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_ADDRESS=briefing@marketpulseindia.app
# Optional SMTP leftovers (not used by email_system/sender.py today):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# --- Subscriber fallback (used only if Supabase is unreachable/unset) --
SUBSCRIBER_LIST=you@example.com,teammate@example.com

# --- WhatsApp delivery (Twilio) -----------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Telegram delivery (Bot API) ----------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=MarketPulseIndiaBot
# Optional override. If unset, a secret is derived from TELEGRAM_BOT_TOKEN.
# You must still register the webhook with that secret (see telegram_sender.register_webhook).
TELEGRAM_WEBHOOK_SECRET=choose-a-long-random-string

# --- Web app / API (api/app.py) ------------------------------------------
WEBAPP_BASE_URL=https://marketpulseindia.app
PORT=8000
